{
  "name": "etf-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.1 <21"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-skip-pattern='PT-ANA-A11Y-001|PT-A11Y-002' tests/Unit/*.test.mjs tests/Integration/*.test.mjs",
    "test:postgres:wp8": "npm run build && node scripts/zero-skip-runner.mjs --test-name-pattern='^CT-DB-001[A-L] ' tests/Integration/wp-8-contract-conformance.test.mjs",
    "test:browser": "npm run build && node scripts/zero-skip-runner.mjs --test-name-pattern='PT-ANA-A11Y-001|PT-A11Y-002' tests/Integration/workbench-accessibility.test.mjs",
    "test:coverage:wp8": "npm run build && node scripts/wp-8-coverage.mjs",
    "test:security:audit": "node scripts/audit-policy.mjs",
    "test:security:sast": "node scripts/sast-guardrail.mjs",
    "test:security:secrets": "node scripts/secret-guardrail.mjs",
    "test:security:evidence": "node scripts/security-evidence-runner.mjs"
  },
  "dependencies": {
    "pg": "8.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "20.19.14",
    "@types/pg": "8.11.6",
    "playwright": "1.63.0",
    "typescript": "5.9.2"
  }
}
