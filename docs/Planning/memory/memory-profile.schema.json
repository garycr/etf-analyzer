{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workspace-template.local/schemas/memory-profile.schema.json",
  "title": "Agent Memory Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated_at",
    "summaries",
    "facts"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work",
        "personal",
        "focus",
        "recent",
        "earlier",
        "long_term"
      ],
      "properties": {
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "updated_at"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "personal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "updated_at"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "updated_at"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "recent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "updated_at"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "earlier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "updated_at"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "long_term": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "updated_at"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "content",
          "category",
          "confidence",
          "created_at",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "preference",
              "knowledge",
              "context",
              "behavior",
              "goal",
              "correction"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "avoid_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "source_record_id": {
                "type": "string",
                "minLength": 1
              },
              "source_record_type": {
                "enum": [
                  "summary",
                  "fact",
                  "lesson",
                  "interaction-record"
                ]
              },
              "entity_type": {
                "enum": [
                  "decision",
                  "task",
                  "risk",
                  "architecture",
                  "insight",
                  "lesson",
                  "context",
                  "preference",
                  "constraint"
                ]
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              }
            }
          }
        }
      },
      "default": []
    }
  }
}
